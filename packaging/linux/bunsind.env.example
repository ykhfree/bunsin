# Environment of the Bunsin server, read by bunsind.service.
# Install it as /etc/bunsin/bunsind.env, owned by root, mode 0640, group bunsin.
# This template holds no secret value. Never commit the installed file.

# Where the profiles, notes and audit logs are stored. The unit creates this directory.
BUNSIN_DATA_DIR=/var/lib/bunsin/data

# The key that encrypts the tokens that owners store on the server. A Linux server uses a key file.
# The server creates the file at the first start. Keep it out of backups of the data directory,
# and keep a copy of it apart: without it every stored token is unreadable.
BUNSIN_KEY_STORE=file
BUNSIN_MASTER_KEY_FILE=/var/lib/bunsin/key/master.key

# The options of `bunsind serve`, separated by spaces. `bunsind serve --help` lists them all.
# The control API on a non-loopback address needs TLS. Put the certificate files where the
# user bunsin can read them, for example /etc/bunsin/tls/.
# Examples (one line only):
#   --listen 0.0.0.0:8787 --tls-cert /etc/bunsin/tls/cert.pem --tls-key /etc/bunsin/tls/key.pem
#   --internal-listen 0.0.0.0:8788 --internal-url https://agents.corp.example --internal-tls-cert ... --internal-tls-key ...
#   --allow-upstream-host llm.corp.example --allow-upstream-host mcp.corp.example
#   --ard-publisher-domain corp.example
#   --allow-stdio-connectors            (read INSTALL.md first)
#   --allow-coding --coding-repo-root /srv/code --coding-program claude-code=/usr/local/bin/claude
BUNSIND_SERVE_ARGS="--listen 127.0.0.1:8787"

# Tokens that the operator supplies instead of the profile owner (optional).
# Name: BUNSIN_SECRET_<PROFILE>__<KEY>, with the profile ID in upper case and `-` as `_`.
# A profile setting names the key; the value goes here, after the `=`. For example:
# BUNSIN_SECRET_KIM__LLM=
